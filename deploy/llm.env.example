# /home/lykoi/secrets/llm.env · 样例（占位符，不含任何真值）
#
# 落址与权限（docs/deploy.md §7）：
#   install -o root -g root -m 600 /dev/null /home/lykoi/secrets/llm.env
#   sudoedit /home/lykoi/secrets/llm.env
#
# 它由 systemd 以 EnvironmentFile 读入（root 读、读完降权到 User=lykoi）。
# /home/lykoi/secrets 在 path guard 的禁区里（policy-core.ts 的 PROTECTED_PATHS）
# —— 她结构上够不着这个目录。
#
# 本文件**永不入库**。仓库里只有这份样例，值只活在服务器上。
#
# 变量名的出处：packages/lykoi-llm-deepseek/vendor/index.js 的
# DEFAULT_API_KEY_ENV = "DEEPSEEK_API_KEY"（vendor 缺省）。它不是 LYKOI_*，
# 所以不触「unit 的 env 面只该有一条 LYKOI_*」那条钉面。
# 凭据是**环境引用**：装配面只写引用名（apiKeyEnv），按请求解析，永不落明文。

DEEPSEEK_API_KEY=<你的 DeepSeek API key>
